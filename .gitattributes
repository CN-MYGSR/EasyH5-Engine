# 统一换行符：仓库内一律 LF，避免 Windows / macOS / Linux 协作时整文件 diff
* text=auto
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 构建产物：由 node _tools/build.js 生成，让 GitHub 折叠它的 diff、不计入语言统计
EasyH5Engine.html linguist-generated=true -diff

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.exe   binary
